---
interface Props {
    eyebrow?: string;
    title: string;
    text: string;
    primaryHref?: string;
    primaryLabel?: string;
    primaryNewTab?: boolean;
    secondaryHref?: string;
    secondaryLabel?: string;
    secondaryNewTab?: boolean;
}

const {
    eyebrow,
    title,
    text,
    primaryHref,
    primaryLabel,
    primaryNewTab = true,
    secondaryHref,
    secondaryLabel,
    secondaryNewTab = true,
} = Astro.props;

const hasPrimary = primaryHref && primaryLabel;
const hasSecondary = secondaryHref && secondaryLabel;
const hasActions = hasPrimary || hasSecondary;
---

<section class='section'>
    <div class='container'>
        <div class='cta-banner'>
            <div class='cta-banner__content'>
                {
                    eyebrow && (
                        <span class='eyebrow eyebrow--light'>{eyebrow}</span>
                    )
                }
                <h2>{title}</h2>
                <p>{text}</p>

                {
                    hasActions && (
                        <div class='cta-actions'>
                            {hasPrimary && (
                                <a
                                    href={primaryHref}
                                    class='button button--primary'
                                    target={primaryNewTab ? "_blank" : undefined}
                                    rel={
                                        primaryNewTab
                                            ? "noopener noreferrer"
                                            : undefined
                                    }
                                >
                                    {primaryLabel}
                                </a>
                            )}

                            {hasSecondary && (
                                <a
                                    href={secondaryHref}
                                    class='button button--secondary button--secondary-light'
                                    target={secondaryNewTab ? "_blank" : undefined}
                                    rel={
                                        secondaryNewTab
                                            ? "noopener noreferrer"
                                            : undefined
                                    }
                                >
                                    {secondaryLabel}
                                </a>
                            )}
                        </div>
                    )
                }
            </div>

            <div class='cta-banner__visual'>
                <div class='cta-banner__card'>
                    <div class='cta-banner__card-inner'>
                        {hasPrimary ? (
                            <a
                                href={primaryHref}
                                target={primaryNewTab ? "_blank" : undefined}
                                rel={primaryNewTab ? "noopener noreferrer" : undefined}
                                class='cta-banner__image-link'
                            >
                                <img
                                    src='/book-cover-2.jpg'
                                    alt='HOTDOG Hundestrikk'
                                    class='cta-banner__image'
                                    loading='lazy'
                                />
                            </a>
                        ) : (
                            <img
                                src='/book-cover-2.jpg'
                                alt='HOTDOG Hundestrikk'
                                class='cta-banner__image'
                                loading='lazy'
                            />
                        )}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
